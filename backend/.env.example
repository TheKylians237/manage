# Connexion MariaDB/MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mat_manage
DB_USER=mat_manage_app
DB_PASSWORD=replace-with-a-strong-password
DB_CONNECTION_LIMIT=10

# Générer SESSION_SECRET avec au moins 32 caractères aléatoires.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Générer une clé aléatoire de 32 octets, encodée en Base64.
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
TRUST_PROXY=0

# SMTP requis pour envoyer les liens de réinitialisation et les avis de sécurité.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Mat-Manage <no-reply@example.com>
