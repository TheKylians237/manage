# Connexion MariaDB/MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mat_manage
DB_USER=mat_manage_app
DB_PASSWORD=replace-with-a-strong-password
DB_CONNECTION_LIMIT=25


APP_ORIGIN=http://localhost:3000
# Adresse stable du serveur utilisée dans les courriels (réinitialisation du mot de passe).
APP_PUBLIC_ORIGIN=http://localhost:3000
APP_TIMEZONE=Africa/Douala
PORT=3000
NODE_ENV=development
# Accès direct au LAN par défaut. Derrière un reverse proxy, listez ses IP/CIDR exacts ; jamais 1/true.
TRUST_PROXY=0
# Sous-réseaux IPv4 autorisés, séparés par des virgules. Vérifiez d’abord le masque réel du LAN.
# Exemple : 192.168.1.0/24
TRUSTED_CLIENT_CIDRS=
# HTTPS facultatif en développement, obligatoire avec NODE_ENV=production.
# Chemins absolus ou relatifs au dossier backend.
TLS_CERT_FILE=
TLS_KEY_FILE=

# SMTP requis pour les rappels de maintenance (5 minutes avant), les liens de réinitialisation et les avis de sécurité.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate a 32-byte key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

SMTP_SECURE=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-smtp-account@example.com
MAIL_PASS=your-smtp-app-password
MAIL_FROM=Mat-Manage <your-sender@example.com>

# Destinataire des avis envoyés depuis le site local.
SITE_CONTACT_EMAIL=ibihiang@gmail.com
